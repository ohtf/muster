# Replace with the relay's public host name. Caddy gets the certificate.
relay.example.org.uk {
	# Metrics are for the operator, not the internet.
	respond /metrics 404
	# Long-poll requests wait up to 25 s; WebSockets stay open.
	reverse_proxy relay:8443 {
		transport http {
			read_timeout 60s
		}
	}
}
