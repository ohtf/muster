<?xml version="1.0" encoding="utf-8"?>
<!--
SPDX-FileCopyrightText: 2026 Open Health Technology Foundation contributors
SPDX-License-Identifier: AGPL-3.0-or-later WITH LicenseRef-PanicButton-app-store-exception

Added to the Tauri MSI (spec/08-deployment.md, Windows): start Panic Button at
sign-in for every user, and let alarms through Windows Firewall.

Firewall: inbound UDP and TCP on port 47474 for panic-button-desktop.exe, on the
Domain and Private profiles. FIREWALL_PUBLIC=1 adds the Public profile.
The rules are removed on uninstall (upgrades remove the old version first,
so the new version's rules survive).

Watchdog: the app registers a per-user Scheduled Task, "Panic Button watchdog
(<user>)" (platform/windows_watchdog.rs). Uninstalling deletes them all; an
upgrade leaves them, and the new version updates its own.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Property Id="FIREWALL_PUBLIC" Secure="yes" />
    <Property Id="PANIC_BUTTON_FW_PROFILES" Value="domain,private" />
    <SetProperty Id="PANIC_BUTTON_FW_PROFILES" Value="any" After="CostFinalize" Sequence="execute">FIREWALL_PUBLIC = "1"</SetProperty>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="PanicButtonAutostart" Guid="e1b2ae5b-6253-42ec-b6b6-33c79bb61a5e" Win64="yes">
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Panic Button"
                       Type="string" Value="&quot;[INSTALLDIR]panic-button-desktop.exe&quot;" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <SetProperty Id="PanicButtonFirewallUdp" Before="PanicButtonFirewallUdp" Sequence="execute"
                 Value="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall add rule name=&quot;Panic Button&quot; dir=in action=allow program=&quot;[INSTALLDIR]panic-button-desktop.exe&quot; protocol=UDP localport=47474 profile=[PANIC_BUTTON_FW_PROFILES]" />
    <CustomAction Id="PanicButtonFirewallUdp" BinaryKey="WixCA" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="PanicButtonFirewallTcp" Before="PanicButtonFirewallTcp" Sequence="execute"
                 Value="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall add rule name=&quot;Panic Button&quot; dir=in action=allow program=&quot;[INSTALLDIR]panic-button-desktop.exe&quot; protocol=TCP localport=47474 profile=[PANIC_BUTTON_FW_PROFILES]" />
    <CustomAction Id="PanicButtonFirewallTcp" BinaryKey="WixCA" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="PanicButtonFirewallRemove" Before="PanicButtonFirewallRemove" Sequence="execute"
                 Value="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;Panic Button&quot;" />
    <CustomAction Id="PanicButtonFirewallRemove" BinaryKey="WixCA" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="PanicButtonWatchdogRemove" Before="PanicButtonWatchdogRemove" Sequence="execute"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -Command &quot;Get-ScheduledTask -TaskName 'Panic Button watchdog*' -ErrorAction SilentlyContinue | Unregister-ScheduledTask -Confirm:$false&quot;" />
    <CustomAction Id="PanicButtonWatchdogRemove" BinaryKey="WixCA" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!-- Remove any earlier rules first, so a repair does not duplicate them. -->
      <Custom Action="PanicButtonFirewallRemove" After="InstallFiles" />
      <Custom Action="PanicButtonFirewallUdp" After="PanicButtonFirewallRemove">NOT (REMOVE ~= "ALL")</Custom>
      <Custom Action="PanicButtonFirewallTcp" After="PanicButtonFirewallUdp">NOT (REMOVE ~= "ALL")</Custom>
      <Custom Action="PanicButtonWatchdogRemove" Before="RemoveFiles">REMOVE ~= "ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
