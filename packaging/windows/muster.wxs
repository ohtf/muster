<?xml version="1.0" encoding="utf-8"?>
<!--
SPDX-FileCopyrightText: 2026 Open Health Technology Foundation contributors
SPDX-License-Identifier: AGPL-3.0-or-later WITH LicenseRef-Muster-app-store-exception

Added to the Tauri MSI (spec/08-deployment.md, Windows): start Muster at
sign-in for every user, and let alarms through Windows Firewall.

Firewall: inbound UDP and TCP on port 47474 for muster-desktop.exe, on the
Domain and Private profiles. FIREWALL_PUBLIC=1 adds the Public profile.
The rules are removed on uninstall (upgrades remove the old version first,
so the new version's rules survive).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Property Id="FIREWALL_PUBLIC" Secure="yes" />
    <Property Id="MUSTER_FW_PROFILES" Value="domain,private" />
    <SetProperty Id="MUSTER_FW_PROFILES" Value="any" After="CostFinalize" Sequence="execute">FIREWALL_PUBLIC = "1"</SetProperty>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MusterAutostart" Guid="e1b2ae5b-6253-42ec-b6b6-33c79bb61a5e" Win64="yes">
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Muster"
                       Type="string" Value="&quot;[INSTALLDIR]muster-desktop.exe&quot;" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <SetProperty Id="MusterFirewallUdp" Before="MusterFirewallUdp" Sequence="execute"
                 Value="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall add rule name=&quot;Muster&quot; dir=in action=allow program=&quot;[INSTALLDIR]muster-desktop.exe&quot; protocol=UDP localport=47474 profile=[MUSTER_FW_PROFILES]" />
    <CustomAction Id="MusterFirewallUdp" BinaryKey="WixCA" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="MusterFirewallTcp" Before="MusterFirewallTcp" Sequence="execute"
                 Value="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall add rule name=&quot;Muster&quot; dir=in action=allow program=&quot;[INSTALLDIR]muster-desktop.exe&quot; protocol=TCP localport=47474 profile=[MUSTER_FW_PROFILES]" />
    <CustomAction Id="MusterFirewallTcp" BinaryKey="WixCA" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="MusterFirewallRemove" Before="MusterFirewallRemove" Sequence="execute"
                 Value="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;Muster&quot;" />
    <CustomAction Id="MusterFirewallRemove" BinaryKey="WixCA" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!-- Remove any earlier rules first, so a repair does not duplicate them. -->
      <Custom Action="MusterFirewallRemove" After="InstallFiles" />
      <Custom Action="MusterFirewallUdp" After="MusterFirewallRemove">NOT (REMOVE ~= "ALL")</Custom>
      <Custom Action="MusterFirewallTcp" After="MusterFirewallUdp">NOT (REMOVE ~= "ALL")</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
