#!/usr/bin/env bash
#
# Check the desktop app: frontend lint (ESLint, Prettier), types and build,
# then clippy and tests for the Tauri crate (needs WebKitGTK and libsoup
# development files on Linux). `npm run format` in apps/desktop fixes
# formatting.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

(cd apps/desktop && { [[ -d node_modules ]] || npm ci; } && npm run lint && npm run check && npm run build)
cargo clippy -p panic-button-desktop --all-targets -- -D warnings
exec cargo test -p panic-button-desktop "$@"
