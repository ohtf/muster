#!/usr/bin/env bash
#
# Run the full Rust test suite: unit tests, golden vectors, simulator
# scenarios and property tests (256 cases by default). The desktop app is
# checked by s/desktop-check, since it needs WebKit and a built frontend.
#
# Pass cargo test arguments through, for example:
#   s/test -p panic-button-sim
#   PROPTEST_CASES=256 s/test --release -p panic-button-sim --test properties
#                                                (CI-scale property run)

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

exec cargo test --workspace --exclude panic-button-desktop --all-features "$@"
