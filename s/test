#!/usr/bin/env bash
#
# Run the full Rust test suite: unit tests, golden vectors, simulator
# scenarios and property tests (256 cases by default).
#
# Pass cargo test arguments through, for example:
#   s/test -p muster-core
#   PROPTEST_CASES=256 s/test --release -p muster-sim --test properties
#                                                (CI-scale property run)

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

exec cargo test --workspace --all-features "$@"
