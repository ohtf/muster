#!/usr/bin/env bash
#
# Run the checks CI enforces, apart from tests: rustfmt, clippy (warnings are
# errors), cargo-deny and REUSE licensing compliance.
#
# cargo-deny and reuse are skipped with a hint if not installed:
#   cargo install --locked cargo-deny
#   pipx install reuse

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

cargo fmt --all --check
cargo clippy --workspace --exclude panic-button-desktop --all-targets --all-features -- -D warnings

if command -v cargo-deny >/dev/null 2>&1; then
  cargo deny check
else
  echo "s/lint: cargo-deny not installed, skipping (cargo install --locked cargo-deny)" >&2
fi

if command -v reuse >/dev/null 2>&1; then
  reuse lint
else
  echo "s/lint: reuse not installed, skipping (pipx install reuse)" >&2
fi
