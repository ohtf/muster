{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muster",
  "mainBinaryName": "muster-desktop",
  "identifier": "org.ohtf.muster",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Call colleagues for help from this computer",
    "copyright": "Open Health Technology Foundation contributors",
    "license": "AGPL-3.0-or-later WITH LicenseRef-Muster-app-store-exception",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "3b23abe3-14bd-403a-8514-62b4a749fc51",
        "fragmentPaths": [
          "../../../packaging/windows/muster.wxs"
        ],
        "componentRefs": [
          "MusterAutostart"
        ]
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/etc/xdg/autostart/muster-desktop.desktop": "../../../packaging/linux/muster-autostart.desktop"
        },
        "depends": [
          "libasound2t64 | libasound2"
        ]
      }
    }
  }
}
